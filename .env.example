# Copie para .env (ignorado pelo git) e preencha com seus valores.
# Senha do SYS/SYSTEM do container Oracle (so para o docker-compose local)
ORACLE_PASSWORD=troque-esta-senha-oracle
# Usuario da aplicacao no Oracle (criado pelo container no PDB FREEPDB1)
DB_USER=veti
DB_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo
# Primeiro administrador, criado na subida da aplicacao (o cadastro publico so cria USER).
# A senha passa pela PKG_VETI.FN_VALIDA_SENHA: minimo 8 caracteres, com letra e numero.
ADMIN_EMAIL=admin@veti.com
ADMIN_PASSWORD=TroqueEstaSenha1
# Opcional: so ativa o login com Google se preenchido
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: envio real dos lembretes por e-mail (Gmail). Use uma "senha de app" do Google
# (Conta Google > Segurança > Verificação em duas etapas > Senhas de app), nunca a senha da conta.
# Sem estas duas variáveis o lembrete é apenas registrado no log.
MAIL_USERNAME=
MAIL_PASSWORD=
# So na EC2 (docker-compose.aws.yml): dominio do HTTPS. Use o IP elastico com hifens + .sslip.io
APP_DOMAIN=18-207-27-110.sslip.io
